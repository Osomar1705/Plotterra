# Frontend FieldShift: true conserva datos de parcela/opciones de demostración.
# El chatbot sigue llamando GPT-4o mini incluso cuando este valor es true.
VITE_USE_LOCAL_MOCKS=true
# Con el servidor incluido: SIEMPRE ai. Para pruebas sin clave, demo es opt-in.
VITE_GUIDE_MODE=ai
# El servidor Node proporciona /api/v1/consultas; Vite redirige ese path a :8787.
VITE_GUIDE_API_URL=/api/v1/consultas
# Solo se usa para las otras operaciones agrícolas cuando LOCAL_MOCKS=false.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
