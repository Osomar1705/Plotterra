# Backend FastAPI. Todas las rutas reales cuelgan de /api/v1.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# false = backend real (lo normal). true = frontend aislado con datos locales,
# solo para trabajar sin backend. Ojo: en true las cifras son inventadas.
VITE_USE_LOCAL_MOCKS=false

# Guia (chat). ai = GPT-4o mini via el servidor Node de server/ (clave en .env.ai).
# demo = respuestas fijas sin clave, solo para probar la interfaz.
VITE_GUIDE_MODE=ai
# En local Vite redirige /api/v1/consultas al servidor del chat (:8787).
# En un deploy sin servidor de chat, apuntarlo al backend:
#   VITE_GUIDE_API_URL=https://<backend>/api/v1/consultas  (interprete por reglas)
VITE_GUIDE_API_URL=/api/v1/consultas
