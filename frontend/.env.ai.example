# SOLO SERVIDOR. Nunca incluir esta clave en variables VITE_*.
# Copia el archivo a .env.ai y coloca tu clave localmente, sin enviarla por chat.
OPENAI_API_KEY=pega_tu_clave_aqui
OPENAI_MODEL=gpt-4o-mini
FIELD_GUIDE_PORT=8787
# En local usa 127.0.0.1; en hosting de servidor configura FIELD_GUIDE_HOST=0.0.0.0
FIELD_GUIDE_HOST=127.0.0.1
# Necesario solo si accedes directamente al servidor desde otro origen.
FIELD_GUIDE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
