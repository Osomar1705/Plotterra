# Copiar a .env y ajustar. El .env no se versiona.

# real = motor de verdad con los datasets; mock = cifras de ejemplo.
FIELDSHIFT_MOTOR=real

FIELDSHIFT_DB=datos/fieldshift.sqlite3
FIELDSHIFT_DATASETS=datasets

# Techo de calculo por comparacion. Hoy tarda unos 470 ms.
FIELDSHIFT_PRESUPUESTO_MS=8000

# Chatbot. Sin clave, /consultas responde con el interprete por reglas
# y el resto del producto funciona igual.
FIELDSHIFT_MODELO_LLM=claude-opus-5-5
ANTHROPIC_API_KEY=
